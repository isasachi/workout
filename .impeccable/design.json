  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one lime action per screen; Empezar on Hoy runs full width at 64px.",
      "html": "<button class=\"ds-btn ds-btn-primary\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M8 5.5v13l10.5-6.5L8 5.5Z\"/></svg>Empezar</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:56px;padding:0 24px;border:0;border-radius:999px;font-size:18px;font-weight:700;cursor:pointer;transition:transform 160ms cubic-bezier(0.22,1,0.36,1),opacity 160ms cubic-bezier(0.22,1,0.36,1)}.ds-btn:active{transform:scale(0.97)}.ds-btn:focus-visible{outline:3px solid var(--accent,#b8f23f);outline-offset:2px}.ds-btn-primary{background:var(--accent,#b8f23f);color:var(--on-accent,#0d1600);font-family:var(--font-display,'Archivo Variable',system-ui,sans-serif);font-stretch:108%;font-weight:800;letter-spacing:-0.01em;min-width:280px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Raised-charcoal pill for every non-primary action.",
      "html": "<button class=\"ds-btn-secondary\">Siguiente ejercicio</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;justify-content:center;min-height:56px;padding:0 24px;border:0;border-radius:999px;background:var(--surface-2,#262629);color:var(--text,#fff);font:700 18px/1 -apple-system,system-ui,sans-serif;cursor:pointer;transition:transform 160ms cubic-bezier(0.22,1,0.36,1)}.ds-btn-secondary:active{transform:scale(0.97)}.ds-btn-secondary:focus-visible{outline:3px solid #b8f23f;outline-offset:2px}"
    },
    {
      "name": "Chips",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Option chips in timed sessions; the selected chip inverts to white.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip\" aria-pressed=\"true\">Caminar</button><button class=\"ds-chip\" aria-pressed=\"false\">Bici</button><button class=\"ds-chip\" aria-pressed=\"false\">Escaleras</button></div>",
      "css": ".ds-chips{display:flex;gap:8px;background:#000;padding:12px}.ds-chip{flex:1 1 0;min-height:44px;padding:0 16px;border:0;border-radius:999px;background:#262629;color:#fff;font:600 16px/1 -apple-system,system-ui,sans-serif;cursor:pointer;transition:background-color 160ms cubic-bezier(0.22,1,0.36,1),color 160ms}.ds-chip[aria-pressed='true']{background:#fff;color:#000}.ds-chip:focus-visible{outline:3px solid #b8f23f;outline-offset:2px}"
    },
    {
      "name": "Week Strip",
      "kind": "custom",
      "refersTo": "week-day",
      "description": "Seven day capsules under the Hoy title; rings in the session hue fill when done; today inverts to white.",
      "html": "<ol class=\"ds-week\"><li><button class=\"ds-day ds-today\"><span class=\"ds-l\">L</span><span class=\"ds-d\">26</span><span class=\"ds-mark\" style=\"--k:#b8f23f\"></span></button></li><li><button class=\"ds-day\"><span class=\"ds-l\">M</span><span class=\"ds-d\">27</span><span class=\"ds-mark ds-done\" style=\"--k:#5ac8fa\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m5 12.5 4.5 4.5L19 7\"/></svg></span></button></li><li><button class=\"ds-day\"><span class=\"ds-l\">X</span><span class=\"ds-d\">28</span><span class=\"ds-mark\" style=\"--k:#ffc24b\"></span></button></li><li><button class=\"ds-day\"><span class=\"ds-l\">S</span><span class=\"ds-d\">31</span><span class=\"ds-mark\" style=\"--k:#ff5c7a\"></span></button></li><li><button class=\"ds-day\"><span class=\"ds-l\">D</span><span class=\"ds-d\">1</span><span class=\"ds-rest\"></span></button></li></ol>",
      "css": ".ds-week{display:grid;grid-template-columns:repeat(5,64px);gap:6px;margin:0;padding:12px;list-style:none;background:#000}.ds-day{display:grid;justify-items:center;gap:4px;width:100%;padding:8px 0 10px;border:0;border-radius:16px;background:#161618;color:#aeaeb2;cursor:pointer;transition:transform 140ms cubic-bezier(0.22,1,0.36,1)}.ds-day:active{transform:scale(0.95)}.ds-day:focus-visible{outline:3px solid #b8f23f;outline-offset:2px}.ds-today{background:#fff;color:#000}.ds-l{font:600 12px/1.2 -apple-system,system-ui,sans-serif}.ds-d{font:700 19px/1 'Archivo Variable',system-ui,sans-serif;font-stretch:82%;font-variant-numeric:tabular-nums}.ds-mark{display:grid;place-items:center;width:20px;height:20px;margin-top:2px;border-radius:999px;border:2px solid var(--k);color:#0d1600}.ds-done{background:var(--k)}.ds-rest{width:8px;height:8px;margin:8px 0 6px;border-radius:999px;background:#3a3a3e}"
    },
    {
      "name": "Technique Stage",
      "kind": "custom",
      "refersTo": "stage",
      "description": "The 3D mannequin stage with corner controls and the fixed step list beneath; only the highlight moves.",
      "html": "<figure class=\"ds-stage-wrap\"><div class=\"ds-stage\"><div class=\"ds-fig\"></div><div class=\"ds-ctrls\"><button class=\"ds-ctrl\" aria-label=\"Pausar\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M8 5v14m8-14v14\"/></svg></button><button class=\"ds-ctrl ds-speed\">1×</button></div></div><ol class=\"ds-steps\"><li>Pies al ancho de hombros</li><li class=\"ds-now\">Baja: cadera atrás y pecho alto</li><li>Sube empujando el suelo</li></ol></figure>",
      "css": ".ds-stage-wrap{margin:0;display:grid;gap:16px;width:340px;padding:12px;background:#000}.ds-stage{position:relative;aspect-ratio:220/196;border-radius:20px;background:radial-gradient(ellipse at 50% 88%,#1a1a1d 0,#111113 60%);overflow:hidden}.ds-fig{position:absolute;left:50%;bottom:14%;width:34px;height:150px;margin-left:-17px;border-radius:17px;background:linear-gradient(#ecebef 0 52%,#b8f23f 52%)}.ds-ctrls{position:absolute;top:10px;right:10px;display:flex;gap:6px}.ds-ctrl{display:grid;place-items:center;width:44px;height:44px;border:0;border-radius:999px;background:rgba(28,28,30,0.78);color:#fff;cursor:pointer;transition:transform 160ms cubic-bezier(0.22,1,0.36,1)}.ds-ctrl:active{transform:scale(0.92)}.ds-ctrl:focus-visible{outline:3px solid #b8f23f;outline-offset:2px}.ds-speed{font:700 15px/1 'Archivo Variable',system-ui,sans-serif;font-stretch:82%}.ds-steps{margin:0;padding:0;list-style:none;display:grid;gap:10px}.ds-steps li{position:relative;padding-left:22px;font:400 17px/1.35 -apple-system,system-ui,sans-serif;color:#8e8e93;transition:color 360ms cubic-bezier(0.22,1,0.36,1)}.ds-steps li::before{content:'';position:absolute;left:2px;top:.42em;width:9px;height:9px;border-radius:999px;background:#3a3a3e}.ds-steps li.ds-now{color:#fff;font-weight:600}.ds-steps li.ds-now::before{background:#b8f23f;transform:scale(1.25)}"
    },
    {
      "name": "Stats Strip",
      "kind": "card",
      "refersTo": "stats-strip",
      "description": "Three condensed numerals in one charcoal group under the stage.",
      "html": "<dl class=\"ds-stats\"><div><dt>Minutos</dt><dd>35–45</dd></div><div><dt>Ejercicios</dt><dd>6</dd></div><div><dt>RIR</dt><dd>3</dd></div></dl>",
      "css": ".ds-stats{display:grid;grid-template-columns:repeat(3,1fr);width:360px;margin:0;border-radius:20px;background:#161618;color:#fff}.ds-stats>div{display:grid;gap:4px;padding:14px 16px 16px}.ds-stats>div+div{border-left:1px solid #2c2c2e}.ds-stats dt{font:600 13px/1.2 -apple-system,system-ui,sans-serif;color:#aeaeb2}.ds-stats dd{margin:0;font:700 34px/1 'Archivo Variable',system-ui,sans-serif;font-stretch:82%;font-variant-numeric:tabular-nums;letter-spacing:-0.01em}"
    },
    {
      "name": "Exercise List",
      "kind": "card",
      "refersTo": "list-group",
      "description": "Grouped list on charcoal with 3D thumbnails, hairlines between rows, press fills raised charcoal.",
      "html": "<ul class=\"ds-list\"><li><button class=\"ds-row\"><span class=\"ds-thumb\"></span><span class=\"ds-t\"><span class=\"ds-n\">Sentadilla libre</span><span class=\"ds-dt\">2 × 10–15</span></span><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m9 6 6 6-6 6\"/></svg></button></li><li><button class=\"ds-row\"><span class=\"ds-thumb\"></span><span class=\"ds-t\"><span class=\"ds-n\">Flexión inclinada</span><span class=\"ds-dt\">2 × 8–12</span></span><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m9 6 6 6-6 6\"/></svg></button></li></ul>",
      "css": ".ds-list{width:360px;margin:0;padding:0;list-style:none;border-radius:20px;background:#161618;overflow:hidden}.ds-list>li+li{border-top:1px solid #2c2c2e}.ds-row{display:grid;grid-template-columns:64px 1fr auto;align-items:center;gap:12px;width:100%;min-height:84px;padding:10px 14px 10px 10px;border:0;background:none;color:#8e8e93;text-align:left;cursor:pointer;transition:background-color 160ms cubic-bezier(0.22,1,0.36,1)}.ds-row:active{background:#262629}.ds-row:focus-visible{outline:3px solid #b8f23f;outline-offset:-3px}.ds-thumb{width:64px;height:57px;border-radius:14px;background:#111113}.ds-t{display:grid;gap:2px}.ds-n{font:600 17px/1.25 -apple-system,system-ui,sans-serif;color:#fff}.ds-dt{font:400 15px/1.3 -apple-system,system-ui,sans-serif;color:#aeaeb2}"
    },
    {
      "name": "Set Row",
      "kind": "custom",
      "refersTo": "set-row",
      "description": "One logged set: steppers around a 44px condensed value and a 64px check that fills lime.",
      "html": "<div class=\"ds-set\"><span class=\"ds-lab\">Serie 1</span><div class=\"ds-val\"><button class=\"ds-adj\" aria-label=\"Menos\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M6 12h12\"/></svg></button><span class=\"ds-num\"><span>12</span><span class=\"ds-u\">reps</span></span><button class=\"ds-adj\" aria-label=\"Más\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M12 6v12M6 12h12\"/></svg></button></div><button class=\"ds-check\" aria-pressed=\"false\" aria-label=\"Hecha\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m5 12.5 4.5 4.5L19 7\"/></svg></button></div>",
      "css": ".ds-set{display:grid;grid-template-columns:1fr auto;grid-template-areas:'l l' 'v c';align-items:center;gap:6px 12px;width:360px;padding:14px 14px 14px 18px;border-radius:20px;background:#161618;color:#fff;transition:background-color 200ms cubic-bezier(0.22,1,0.36,1)}.ds-set:has([aria-pressed='true']){background:#1e2a0c}.ds-lab{grid-area:l;font:600 15px/1.2 -apple-system,system-ui,sans-serif;color:#aeaeb2}.ds-val{grid-area:v;display:flex;align-items:center;gap:10px}.ds-adj{display:grid;place-items:center;width:48px;height:48px;border:0;border-radius:999px;background:#262629;color:#fff;cursor:pointer;transition:transform 140ms}.ds-adj:active{transform:scale(0.92)}.ds-num{display:inline-flex;align-items:baseline;justify-content:center;gap:6px;min-width:96px}.ds-num>:first-child{font:700 44px/1 'Archivo Variable',system-ui,sans-serif;font-stretch:82%;font-variant-numeric:tabular-nums}.ds-u{font:400 15px/1 -apple-system,system-ui,sans-serif;color:#aeaeb2}.ds-check{grid-area:c;display:grid;place-items:center;width:64px;height:64px;border:0;border-radius:999px;background:#262629;color:#fff;cursor:pointer;transition:transform 140ms,background-color 200ms}.ds-check:hover{background:#3a3a3e}.ds-check[aria-pressed='true']{background:#b8f23f;color:#0d1600}.ds-check:focus-visible,.ds-adj:focus-visible{outline:3px solid #b8f23f;outline-offset:2px}"
    },
    {
      "name": "Tab Bar",
      "kind": "nav",
      "refersTo": "tab-bar",
      "description": "Fixed three-item bar on stage black; current tab in white.",
      "html": "<nav class=\"ds-tabs\"><button class=\"ds-tab\" aria-current=\"page\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3v2M12 19v2M5 12H3m18 0h-2M6.3 6.3 4.9 4.9m14.2 14.2-1.4-1.4M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4M12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z\"/></svg><span>Hoy</span></button><button class=\"ds-tab\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 7h16M4 12h16M4 17h10M8 3v4m8-4v4M5 21h14a1 1 0 0 0 1-1V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v15a1 1 0 0 0 1 1Z\"/></svg><span>Plan</span></button><button class=\"ds-tab\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 20V11m7 9V4m7 16v-6\"/></svg><span>Progreso</span></button></nav>",
      "css": ".ds-tabs{display:grid;grid-template-columns:repeat(3,1fr);width:390px;padding:6px 16px;background:#111113}.ds-tab{display:grid;justify-items:center;gap:2px;min-height:58px;padding:6px 0 0;border:0;background:none;color:#8e8e93;font:600 12px/1.2 -apple-system,system-ui,sans-serif;cursor:pointer;transition:color 160ms cubic-bezier(0.22,1,0.36,1)}.ds-tab:hover{color:#aeaeb2}.ds-tab[aria-current='page']{color:#fff}.ds-tab:focus-visible{outline:3px solid #b8f23f;outline-offset:-3px;border-radius:12px}"
    }
  ],
  "narrative": {
    "northStar": "The Coach on the Floor",
    "overview": "**Creative North Star: \"The Coach on the Floor\"**\n\nEntreno is the category standard played straight: Apple Fitness and Nike Training Club, read from a phone propped on the floor. The ground is true black, surfaces climb in three soft charcoal steps, ink is white, and one lime carries every action and every \"done\". Each screen has one dominant thing: a large wide title, a 3D technique figure, or a single counted number. Everything else steps back in grey.\n\nThe premium pass gives the system two voices. Archivo Variable speaks for the app: stretched wide (112%) and heavy (800) for titles, pulled condensed (82%) for every numeral, so counts and timers sit tall and tight. SF Pro speaks for the coach's words: body copy, cues, labels, and the tab bar. The technique stage is the signature: a matte clay mannequin in a dark studio, lit by a white key and a cool rim, its working muscles in lime, with the full list of the rep's steps fixed beneath it so only the highlight moves.\n\nDensity is low and targets are large, because the user glances from two metres away between sets. Depth in the interface comes only from tonal steps; the one place with real light and shadow is inside the stage.",
    "keyCharacteristics": [
      "True black ground, three charcoal surface steps, white ink, one lime.",
      "Wide heavy Archivo titles, condensed tabular Archivo numerals, SF Pro for words.",
      "A 3D clay mannequin on a dark studio stage, working muscles in lime.",
      "Every step of the rep listed under the stage; only the highlight moves.",
      "Session hues only as small marks: dots, rings, segments.",
      "Soft 20px cards, full pills for every button, an iOS-style tab bar."
    ],
    "rules": [
      {
        "name": "The One Voice Rule",
        "body": "Lime is the only colour that means \"tap this\" or \"done\". Never introduce a second action colour.",
        "section": "colors"
      },
      {
        "name": "The Marker-Only Rule",
        "body": "Session hues appear only as small marks (dots, rings, segments at most 28px wide). They never fill a button, a card, or a title.",
        "section": "colors"
      },
      {
        "name": "The Amber Recovery Rule",
        "body": "Recovery is amber, never blue: a second blue reads as cardio's cyan at dot size, and blue-violet is a house-banned hue.",
        "section": "colors"
      },
      {
        "name": "The Two Widths Rule",
        "body": "Archivo appears at exactly two widths: 112% for words, 82% for numbers. Titles are never condensed and numerals are never wide.",
        "section": "typography"
      },
      {
        "name": "The Tabular Number Rule",
        "body": "Every count, time, dose, date, and week number is set in the condensed numeral face with tabular figures. Words never are.",
        "section": "typography"
      },
      {
        "name": "The Floor Distance Rule",
        "body": "Anything read mid-session (cues, the current step, the logged value) is at least 17px; the number being counted is at least 44px.",
        "section": "typography"
      },
      {
        "name": "The Tonal Step Rule",
        "body": "To lift something in the interface, move it one step up the ground / surface / raised ladder. Never add a shadow.",
        "section": "elevation"
      },
      {
        "name": "The Lit Stage Rule",
        "body": "Light, shadow, and fog belong to the technique stage alone; they never leak out into cards or buttons.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep every screen to one dominant thing: one figure, one number, or one large title, with the primary lime pill at thumb reach.",
      "Do set titles in Archivo at 800 and 112% width, and every number in Archivo at 82% width with tabular figures.",
      "Do keep the full list of the rep's steps under the stage and move only the highlight.",
      "Do place demo controls in the stage's top-right corner as 44px translucent dark circles, clear of the figure's working area.",
      "Do show session type with a small hue dot or ring beside the title, in the week strip, or in a grid, never with a coloured surface.",
      "Do mark completion with the lime family: lime check, lime-tint row, pale-lime banner text.",
      "Do use the single house ease (cubic-bezier(0.22, 1, 0.36, 1)) at 140 to 360ms for presses, fades, and rises."
    ],
    "donts": [
      "Don't use shadows to separate interface surfaces; step the tone instead. Hairlines are for rows inside one group only.",
      "Don't add a second accent or let a session hue fill a button, card, or heading.",
      "Don't add a blue or blue-violet session colour; recovery stays amber so it never reads as cardio's cyan at dot size.",
      "Don't condense a title or widen a numeral.",
      "Don't put overlays or labels over the figure; the stage corner is the only place for controls.",
      "Don't set mid-session reading text below 17px or tap targets below 44px.",
      "Don't add small uppercase labels above titles; titles stand on their own with a meta line beneath."
    ]
  }
}